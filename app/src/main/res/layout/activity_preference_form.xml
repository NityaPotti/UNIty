<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surfaceBg">

    <!-- App Bar -->
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:theme="@style/ThemeOverlay.Material3.ActionBar">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/topAppBar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/gt_navy"
            app:title="Your Preferences"
            app:titleTextColor="@color/gt_white"
            app:navigationIcon="?attr/homeAsUpIndicator"
            app:navigationIconTint="@color/gt_white"
            app:layout_scrollFlags="scroll|enterAlways"/>
    </com.google.android.material.appbar.AppBarLayout>

    <!-- Scrollable content -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        android:padding="16dp"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:baselineAligned="false">

            <!-- Name -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="20dp"
                app:cardUseCompatPadding="false"
                app:strokeColor="@color/gt_gold"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:hintEnabled="true"
                        app:boxBackgroundMode="outline"
                        app:boxStrokeColor="@color/gt_gold"
                        android:textColorHint="@color/gt_slate">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/Name"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="What’s your name?"
                            android:textCursorDrawable="@drawable/cursor_gt_slate"/>
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Gender -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="20dp"
                app:strokeColor="@color/gt_gold"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="What is your gender?"
                        android:textStyle="bold"
                        android:textColor="@color/gt_slate"
                        android:textSize="16sp"/>

                    <RadioGroup
                        android:id="@+id/rgGender"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingTop="8dp">

                        <com.google.android.material.radiobutton.MaterialRadioButton
                            android:id="@+id/rbMale"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:buttonTint="@color/gt_gold"
                            android:text="Male"/>

                        <com.google.android.material.radiobutton.MaterialRadioButton
                            android:id="@+id/rbFemale"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            app:buttonTint="@color/gt_gold"
                            android:text="Female"/>

                        <com.google.android.material.radiobutton.MaterialRadioButton
                            android:id="@+id/rbOther"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            app:buttonTint="@color/gt_gold"
                            android:text="Other"/>
                    </RadioGroup>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Temperature -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="20dp"
                app:strokeColor="@color/gt_gold"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:padding="16dp"
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Preferred room temperature"
                        android:textStyle="bold"
                        android:textColor="@color/gt_slate"
                        android:textSize="16sp"/>

                    <RadioGroup
                        android:id="@+id/rgTemperature"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingTop="8dp"
                        android:orientation="vertical">

                        <com.google.android.material.radiobutton.MaterialRadioButton
                            android:id="@+id/rbCooler"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:buttonTint="@color/gt_gold"
                            android:text="Cooler ≤ 68°F"/>

                        <com.google.android.material.radiobutton.MaterialRadioButton
                            android:id="@+id/Cool"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:buttonTint="@color/gt_gold"
                            android:text="Cool 68 - 70°F"/>

                        <com.google.android.material.radiobutton.MaterialRadioButton
                            android:id="@+id/rbTemperate"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:buttonTint="@color/gt_gold"
                            android:text="Temperate 70 – 72°F"/>

                        <com.google.android.material.radiobutton.MaterialRadioButton
                            android:id="@+id/rbWarmer"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Warmer ≥ 72°F"
                            app:buttonTint="@color/gt_gold" />
                    </RadioGroup>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Bedtime -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="20dp"
                app:strokeColor="@color/gt_gold"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="When do you go to bed?"
                        android:textColor="@color/gt_slate"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <RadioGroup
                        android:id="@+id/rgBedtime"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingTop="8dp">

                        <com.google.android.material.radiobutton.MaterialRadioButton
                            android:id="@+id/rbBedtime0"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:buttonTint="@color/gt_gold"
                            android:text="Before 10 PM" />

                        <com.google.android.material.radiobutton.MaterialRadioButton
                            android:id="@+id/rbBedtime1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:buttonTint="@color/gt_gold"
                            android:text="10 – 11 PM" />

                        <com.google.android.material.radiobutton.MaterialRadioButton
                            android:id="@+id/rbBedtime2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:buttonTint="@color/gt_gold"
                            android:text="11 PM – 12 AM" />

                        <com.google.android.material.radiobutton.MaterialRadioButton
                            android:id="@+id/rbBedtime3"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:buttonTint="@color/gt_gold"
                            android:text="After 12 AM" />
                    </RadioGroup>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Cleanliness -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="20dp"
                app:strokeColor="@color/gt_gold"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:padding="16dp"
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Cleanliness"
                        android:textStyle="bold"
                        android:textColor="@color/gt_slate"
                        android:textSize="16sp"/>

                    <com.google.android.material.slider.Slider
                        android:id="@+id/seekBarClean"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:valueFrom="0"
                        android:valueTo="20"
                        android:value="10"
                        app:tickVisible="false"
                        app:labelBehavior="withinBounds"
                        app:trackColorActive="@color/gt_gold"
                        app:trackColorInactive="@color/gt_navy_tint"
                        app:thumbColor="@color/gt_navy_light"
                        app:thumbTint="@color/gt_gold"/>

                    <TextView
                        android:id="@+id/tvClean"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Cleanliness: "
                        android:textColor="@color/gt_slate"
                        android:layout_marginTop="6dp"/>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Location / LLC -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/LocationLLC"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="20dp"
                app:strokeColor="@color/gt_gold"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:padding="16dp"
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Where will you live?"
                        android:textStyle="bold"
                        android:textColor="@color/gt_slate"
                        android:textSize="16sp"/>

                    <RadioGroup
                        android:id="@+id/rgOnCampus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        app:buttonTint="@color/gt_gold"
                        android:paddingTop="8dp">

                        <com.google.android.material.radiobutton.MaterialRadioButton
                            android:id="@+id/rbOnCampus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:buttonTint="@color/gt_gold"
                            android:text="On campus"/>

                        <com.google.android.material.radiobutton.MaterialRadioButton
                            android:id="@+id/rbOffCampus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            app:buttonTint="@color/gt_gold"
                            android:text="Off campus"/>
                    </RadioGroup>

                    <TextView
                        android:id="@+id/tvLocation"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Preferred location"
                        android:textStyle="bold"
                        android:textColor="@color/gt_slate"
                        android:layout_marginTop="12dp"
                        android:visibility="gone"
                        android:textSize="16sp"/>

                    <RadioGroup
                        android:id="@+id/rgLocation"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:visibility="gone"
                        android:paddingTop="8dp">

                        <com.google.android.material.radiobutton.MaterialRadioButton
                            android:id="@+id/rbEast"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:buttonTint="@color/gt_gold"
                            android:text="East"/>

                        <com.google.android.material.radiobutton.MaterialRadioButton
                            android:id="@+id/rbWest"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            app:buttonTint="@color/gt_gold"
                            android:text="West"/>

                        <com.google.android.material.radiobutton.MaterialRadioButton
                            android:id="@+id/rbEither"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            app:buttonTint="@color/gt_gold"
                            android:text="Either"/>
                    </RadioGroup>

                    <TextView
                        android:id="@+id/tvLLC"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Living Learning Community"
                        android:textStyle="bold"
                        android:textColor="@color/gt_slate"
                        android:layout_marginTop="12dp"
                        android:visibility="gone"
                        android:textSize="16sp"/>

                    <RadioGroup
                        android:id="@+id/rgLLC"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone"
                        android:paddingTop="8dp">

                        <com.google.android.material.radiobutton.MaterialRadioButton
                            android:id="@+id/rbNone"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:buttonTint="@color/gt_gold"
                            android:text="None"/>

                        <com.google.android.material.radiobutton.MaterialRadioButton
                            android:id="@+id/rbExplore"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:buttonTint="@color/gt_gold"
                            android:text="Explore"/>

                        <com.google.android.material.radiobutton.MaterialRadioButton
                            android:id="@+id/rbGC"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:buttonTint="@color/gt_gold"
                            android:text="Grand Challenges"/>

                        <com.google.android.material.radiobutton.MaterialRadioButton
                            android:id="@+id/rbHP"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:buttonTint="@color/gt_gold"
                            android:text="Honors Program"/>

                        <com.google.android.material.radiobutton.MaterialRadioButton
                            android:id="@+id/rbGlobalLeadership"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:buttonTint="@color/gt_gold"
                            android:text="Global Leadership"/>
                    </RadioGroup>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Max Rent -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="20dp"
                app:strokeColor="@color/gt_gold"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:padding="16dp"
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Maximum expected rent"
                        android:textStyle="bold"
                        android:textColor="@color/gt_slate"
                        android:textSize="16sp"/>

                    <com.google.android.material.slider.Slider
                        android:id="@+id/seekBarMaxRent"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:valueFrom="0"
                        android:valueTo="7"
                        android:value="1"
                        android:stepSize=".01"
                        app:tickVisible="false"
                        app:labelBehavior="withinBounds"
                        app:trackColorActive="@color/gt_gold"
                        app:trackColorInactive="@color/gt_navy_tint"
                        app:thumbColor="@color/gt_navy_light"
                        app:thumbTint="@color/gt_gold"/>

                    <TextView
                        android:id="@+id/rentValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Maximum expected rent: $1400"
                        android:textColor="@color/gt_slate"
                        android:layout_marginTop="6dp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Profile Visibility Switch -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="20dp"
                app:strokeColor="@color/gt_gold"
                app:strokeWidth="1dp">

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/visibilitySwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:textSize="16sp"
                    android:layout_margin="16dp"
                    app:thumbTint="@color/gt_white"
                    app:trackTint="@color/gt_navy"
                    android:layout_gravity="right"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:text="Profile Visible"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginTop="28dp"/>
            </com.google.android.material.card.MaterialCardView>

            <!-- About + Buttons -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="20dp"
                app:strokeColor="@color/gt_gold"
                app:strokeWidth="1dp"
                android:layout_marginTop="10dp">

                <LinearLayout
                    android:padding="16dp"
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:boxBackgroundMode="outline"
                        app:boxStrokeColor="@color/gt_gold"
                        android:hint="About you"
                        android:textColorHint="@color/gt_slate">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/textEditAbout"
                            android:layout_width="match_parent"
                            android:layout_height="120dp"
                            android:gravity="start|top"
                            android:inputType="textMultiLine"
                            android:maxLines="6"
                            android:textCursorDrawable="@drawable/cursor_gt_slate"/>
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Buttons -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="end"
                        android:layout_marginTop="16dp">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnBack"
                            style="?attr/materialButtonOutlinedStyle"
                            android:layout_width="wrap_content"
                            android:layout_height="48dp"
                            android:text="Skip for now"
                            app:strokeColor="@color/gt_gold"
                            android:textColor="@color/gt_navy"
                            app:iconTint="@color/gt_navy" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSubmit"
                            android:layout_width="wrap_content"
                            android:layout_height="48dp"
                            android:layout_marginStart="12dp"
                            android:text="Submit"
                            app:backgroundTint="@color/gt_gold"
                            android:state_pressed="true"
                            android:color="@color/gt_navy"
                            android:textColor="@color/colorOnPrimary" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
