<?xml version="1.0" encoding="utf-8"?>



<ScrollView
        xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFEB99"
            android:gravity="center"
            android:padding="0dp">

        <!-- Gender -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="What is your gender?"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#442222" />

        <RadioGroup
            android:id="@+id/rgGender"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <RadioButton
                android:id="@+id/rbMale"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Male" />

            <RadioButton
                android:id="@+id/rbFemale"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Female" />

            <RadioButton
                android:id="@+id/rbOther"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Other" />
        </RadioGroup>

        <!-- Temperature -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="What's your preferable temperature?"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#442222" />

        <RadioGroup
            android:id="@+id/rgTemperature"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <RadioButton
                android:id="@+id/rbCooler"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Make it cooler (-459 to 60 F)" />

            <RadioButton
                android:id="@+id/rbTemperate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Make it somewhere in the middle (60 to 80 F)" />

            <RadioButton
                android:id="@+id/rbWarmer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Make it warmer (80 to 9999 F)" />
        </RadioGroup>

        <!-- Bedtime -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="When do you go to bed?"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#442222" />

        <RadioGroup
            android:id="@+id/rgBedtime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <RadioButton
                android:id="@+id/rbBedtime0"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Before 10PM" />

            <RadioButton
                android:id="@+id/rbBedtime1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="10PM - 11PM" />

            <RadioButton
                android:id="@+id/rbBedtime2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="11PM - 12AM" />

            <RadioButton
                android:id="@+id/rbBedtime3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="After 12AM" />
        </RadioGroup>

        <!-- Submit button -->
            <TextView
                android:id="@+id/textView3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Cleaniness"
                android:textSize="20sp"
                android:textStyle="bold" />

            <SeekBar
                android:id="@+id/seekBarClean"
                style="@style/Widget.AppCompat.SeekBar.Discrete"
                android:layout_width="match_parent"
                android:layout_height="35dp"
                android:max="10"
                android:progress="5"
                android:progressTint="#6750A3" />

            <TextView
                android:id="@+id/textView5"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Where will you live"
                android:textSize="20sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/rgOnCampus"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <RadioButton
                    android:id="@+id/rbOnCampus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="On campus" />

                <RadioButton
                    android:id="@+id/rbOffCampus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Off Campus" />
            </RadioGroup>

            <TextView
                android:id="@+id/textView6"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Preferred location"
                android:textSize="20sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/rgLocation"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <RadioButton
                    android:id="@+id/rbEast"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="East" />

                <RadioButton
                    android:id="@+id/rbWest"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="West" />
            </RadioGroup>

            <TextView
                android:id="@+id/LLCTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Living Learning Community"
                android:textSize="20sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/rgLLC"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <RadioButton
                    android:id="@+id/rbNone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="None" />

                <RadioButton
                    android:id="@+id/rbExplore"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Exprolre" />

                <RadioButton
                    android:id="@+id/rbGC"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Grand Challenges" />

                <RadioButton
                    android:id="@+id/rbHP"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Honors Program" />

                <RadioButton
                    android:id="@+id/rbGlobalLeadership"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Global Leadership" />

            </RadioGroup>

            <TextView
                android:id="@+id/textView9"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Maximum expected rent"
                android:textSize="20sp"
                android:textStyle="bold" />

            <SeekBar
                android:id="@+id/seekBarMaxRent"
                style="@style/Widget.AppCompat.SeekBar.Discrete"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="7"
                android:progress="3" />

            <TextView
                android:id="@+id/rentValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Maximum Expected rent value: 1400" />

            <TextView
                android:id="@+id/textView7"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="About"
                android:textSize="20sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/textEditAbout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ems="10"
                android:gravity="start|top"
                android:inputType="textMultiLine"
                android:text="write something about you" />

            <Button
                android:id="@+id/btnSubmit"
                android:layout_width="200dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="48dp"
                android:background="@drawable/button"
                android:padding="12dp"
                android:text="Submit"
                android:textColor="#ffffff"
                android:textSize="18sp" />

        </LinearLayout>
    </ScrollView>


